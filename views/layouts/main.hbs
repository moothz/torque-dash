    <script>
        $(document).ready(function() {
            $('.lang-select-btn').on('click', function(e) {
                e.preventDefault();
                let lang = $(this).data('lang');
                let url = new URL(window.location.href);
                url.searchParams.set('lang', lang);
                window.location.href = url.toString();
            });
        });
