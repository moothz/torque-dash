    <script>
        window.translations = {{{json translations}}};
        window.currentLang = "{{lang}}";
        window.__ = function(key) {
            if (!key) return "";
            if (!window.translations) return key;
            if (window.translations[key] !== undefined) return window.translations[key];
            
            let lookupKey = String(key).trim();
            
            // Case-insensitive direct match
            let lowerKey = lookupKey.toLowerCase();
            for (let k in window.translations) {
                if (k.toLowerCase() === lowerKey) {
                    return window.translations[k];
                }
            }
            
            // Handle ECU prefix: e.g. "ECU(7E9): Engine RPM(rpm)"
            let ecuMatch = lookupKey.match(/^ECU\([^)]+\):\s*(.*)$/i);
            if (ecuMatch) {
                let baseKey = ecuMatch[1].trim();
                let lowerBase = baseKey.toLowerCase();
                for (let k in window.translations) {
                    if (k.toLowerCase() === lowerBase) {
                        return "ECU: " + window.translations[k];
                    }
                }
            }
            return key;
        };
    </script>
